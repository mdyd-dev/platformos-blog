{% doc %}
  Update the blog_instance settings record (build -> check -> execute).

  @param {object} object - raw form params for blog settings (must include `id`)
  @returns {object} the updated record on success, or the invalid object with `errors`
{% enddoc %}
{% liquid
  function object = 'modules/blog/commands/blog_instances/build', object: object
  function object = 'modules/blog/commands/blog_instances/check', object: object
  if object.valid
    function object = 'modules/core/commands/execute', mutation_name: 'modules/blog/blog_instances/update', object: object, selection: 'record'
  endif
  return object
%}

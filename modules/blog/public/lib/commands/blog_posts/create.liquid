{% doc %}
  Create a blog_post record (build -> check -> execute).

  @param {object} object - raw form params for a blog post
  @returns {object} the created record on success, or the invalid object with `errors`
{% enddoc %}
{% liquid
  function object = 'modules/blog/commands/blog_posts/build', object: object
  function object = 'modules/blog/commands/blog_posts/check', object: object
  if object.valid
    function object = 'modules/core/commands/execute', mutation_name: 'modules/blog/blog_posts/create', object: object, selection: 'record'
  endif
  return object
%}

---
slug: edit-profile
layout: modules/blog/blog
---
{% content_for 'meta_title' %}{{ 'modules/blog/auth.edit_profile' | t }}{% endcontent_for %}
{% liquid
  function profile = 'modules/user/helpers/current_profile'
  if profile.user == null
    function _ = 'modules/user/helpers/flash', info: 'modules/blog/auth.log_in_to_continue', error: null, force_clear: null, notice: null
    session return_to = '/edit-profile'
    redirect_to '/sessions/new'
    break
  endif

  assign values = '{}' | parse_json
  assign values = values | hash_add_key: 'first_name', profile.first_name
  assign values = values | hash_add_key: 'last_name', profile.last_name
  assign values = values | hash_add_key: 'email', profile.user.email

  render 'modules/blog/auth/profile_form', context: context, values: values, errors: null
%}

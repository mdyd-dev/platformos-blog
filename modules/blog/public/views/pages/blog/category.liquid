---
slug: 'blog/category(/:tags)'
layout_name: 'modules/blog/blog'
---
{% liquid
  assign tags = null
  if context.params.tags != blank
    assign tags = context.params.tags | replace: '-', ' '
  endif
  assign pagination_page = context.params.page | default: 1 | plus: 0
  assign per_page = context.params.per_page | default: 10 | plus: 0
  assign feature_post_first = false
  if pagination_page == 1
    assign feature_post_first = true
  endif
  function blog_instance = 'modules/blog/queries/blog_instances/find', scope: 'blog', slug: null, enabled: true
  assign blog_posts = null
  if blog_instance
    assign today = 'now' | date: '%F'
    function blog_posts = 'modules/blog/queries/blog_posts/search', per_page: per_page, page: pagination_page, blog_instance_id: blog_instance.id, tags: tags, slug: null, published_at_lte: today, published_at_lt: null, published_at_gt: null, except_ids: null
  endif
%}
{% include 'modules/blog/blog/index',
  blog_instance: blog_instance,
  blog_posts: blog_posts,
  slug: 'blog',
  tags: tags,
  feature_post_first: feature_post_first
%}

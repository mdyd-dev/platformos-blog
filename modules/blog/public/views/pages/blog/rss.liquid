---
slug: 'blog/rss'
format: xml
---
{%- liquid
  function blog_instance = 'modules/blog/queries/blog_instances/find', scope: null, slug: null, enabled: null
  assign base_url = 'https://' | append: context.location.host
-%}
{%- if blog_instance -%}
{%- liquid
    assign now_iso = 'now' | date: '%Y-%m-%dT%H:%M:%S.%LZ'
    function blog_posts = 'modules/blog/queries/blog_posts/search', per_page: null, page: null, blog_instance_id: blog_instance.id, tags: context.params.tags, slug: null, published_at_lte: now_iso, published_at_lt: null, published_at_gt: null, except_ids: null
-%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
    <channel>
      <title>{{ blog_instance.title }}</title>
      {{ '<link>' }}{{ base_url }}/{{ '</link>' }}
      {%- for blog_post in blog_posts.results -%}
        <item>
          <title>{{ blog_post.title }}</title>
          <description>{{ blog_post.excerpt }}</description>
          <pubDate>{{ blog_post.published_at  | localize: 'long' }}</pubDate>
          {{ '<link>' }}{{ base_url }}/blog/post/{{ blog_instance.slug }}/{{ blog_post.slug }}{{ '</link>' }}
          <guid>{{ base_url }}/blog/post/{{ blog_instance.slug }}/{{ blog_post.slug }}</guid>
        </item>
      {%- endfor -%}
    </channel>
  </rss>
{% endif %}

---
slug: 'blog/post/:blog_slug/:post_slug'
format: html
layout: 'modules/blog/blog'
---
{% liquid
  assign url = 'https://' | append: context.location.host | append: context.location.href
  assign blog_slug = context.params.blog_slug
  assign post_slug = context.params.post_slug
  function blog_instance = 'modules/blog/queries/blog_instances/find', scope: 'blog', slug: blog_slug, enabled: true
%}

{% if blog_slug != blank and post_slug != blank and blog_instance %}

  {% liquid
    assign today = 'now' | date: '%F'
    function posts = 'modules/blog/queries/blog_posts/search', per_page: null, page: null, blog_instance_id: blog_instance.id, tags: null, slug: post_slug, published_at_lte: today, published_at_lt: null, published_at_gt: null, except_ids: null
    assign blog_post = posts.results.first
  %}

  {%- if blog_post -%}
    {% liquid
      function prev_collection = 'modules/blog/queries/blog_posts/search', per_page: null, page: null, blog_instance_id: blog_post.blog_instance_id, tags: null, slug: null, published_at_lte: null, published_at_lt: blog_post.published_at, published_at_gt: null, except_ids: null
      assign previous_post = prev_collection.results.first
      function next_collection = 'modules/blog/queries/blog_posts/search', per_page: null, page: null, blog_instance_id: blog_post.blog_instance_id, tags: null, slug: null, published_at_lte: today, published_at_lt: null, published_at_gt: blog_post.published_at, except_ids: null
      assign next_post = next_collection.results.last
      assign posts_required_size = 3
      function related_collection = 'modules/blog/queries/blog_posts/search', per_page: posts_required_size, page: null, blog_instance_id: blog_post.blog_instance_id, tags: blog_post.tags, slug: null, published_at_lte: today, published_at_lt: null, published_at_gt: null, except_ids: blog_post.id
      function other_collection = 'modules/blog/queries/blog_posts/search', per_page: posts_required_size, page: null, blog_instance_id: blog_post.blog_instance_id, tags: null, slug: null, published_at_lte: today, published_at_lt: null, published_at_gt: null, except_ids: blog_post.id
      assign related_posts = related_collection.results | concat: other_collection.results | uniq | limit: posts_required_size
      assign word_count = blog_post.content | strip_html | split: ' ' | size
      assign read_minutes = word_count | divided_by: 180 | plus: 1
    %}

    {% content_for 'meta_title' %}
      {{ blog_post.title }}
    {% endcontent_for %}
    {% content_for 'meta_desc' %}
      {{- blog_post.excerpt | strip_html | truncate: 160 -}}
    {% endcontent_for %}

    {%- capture post_meta -%}
      {%- assign author_avatar_path = blog_post.author_avatar.versions.thumb | default: blog_post.author_avatar.url -%}
      {% render 'modules/common-styling/user/avatar', size: 'md', name: blog_post.author_name, image_src: author_avatar_path, class: null %}
      <span>{{ 'modules/blog/blog.by_author' | t }} <b>{{ blog_post.author_name }}</b></span>
      <span aria-hidden="true">&middot;</span>
      <time datetime="{{ blog_post.published_at | date: '%F' }}">{{ blog_post.published_at | date: '%b %-d, %Y' }}</time>
      <span aria-hidden="true">&middot;</span>
      <span>{{ 'modules/blog/blog.min_read' | t: minutes: read_minutes }}</span>
    {%- endcapture -%}

    {% assign image_url = blog_post.hero_image.versions.lg | default: blog_post.hero_image.url %}
    {%- render 'modules/blog/blog/hero',
      title: blog_post.title,
      subtitle: null,
      img_path: image_url,
      meta_html: post_meta
      -%}

    <div class="blog-container blog-section">

      <div class="blog-article">

        <article class="pos-card blog-article-card">

          <div class="pos-prose">
            {{ blog_post.content | markdown }}
          </div>

          <footer class="blog-article-footer">

            {%- if blog_post.tags.size > 0 -%}
              <ul class="pos-tags-list">
                {%- for tag in blog_post.tags -%}
                  <li><a class="pos-tag pos-tag-interactive" href="/blog/category/{{ tag | replace: ' ', '-' }}">{{ tag }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {% liquid
              assign share_label = 'modules/blog/blog.share' | t
              render 'modules/blog/blog/share-list', title: share_label, text: blog_post.title, page_url: url
            %}

          </footer>

        </article>

        {% assign author_avatar_path = blog_post.author_avatar.versions.thumb | default: blog_post.author_avatar.url %}
        <div class="pos-card blog-author-card">
          {% render 'modules/common-styling/user/avatar', size: 'xl', name: blog_post.author_name, image_src: author_avatar_path, class: null %}
          <div>
            <p class="blog-author-card-name">{{ blog_post.author_name }}</p>
            {%- if blog_post.author_biography != blank -%}
              <p class="blog-author-card-bio">{{ blog_post.author_biography }}</p>
            {%- endif -%}
          </div>
        </div>

        {%- render 'modules/blog/blog/siblings-nav',
          previous_post: previous_post,
          next_post: next_post,
          blog_instance: blog_instance
        -%}

        {%- render 'modules/blog/blog/comments',
          page_url: url,
          facebook_app_id: blog_instance.facebook_app_id
        -%}

      </div>

    </div>

    {% liquid
      assign related_title = 'modules/blog/blog.related_articles' | t
      render 'modules/blog/blog/posts-section', section_title: related_title, related_posts: related_posts, blog_instance: blog_instance
    %}

    {% liquid
      function profile = 'modules/user/helpers/current_profile'
      function can_manage = 'modules/user/helpers/can_do', requester: profile, do: 'blog.manage', entity: null, access_callback: null
    %}
    {%- if can_manage -%}
      {% liquid
        assign edit_post_href = '/dashboard/posts/edit/' | append: blog_post.id
        assign edit_post_label = 'modules/blog/blog.edit_post' | t
        render 'modules/blog/blog/flying-button', btn_text: edit_post_label, btn_href: edit_post_href, btn_icon: 'pencil'
      %}
    {%- endif -%}
  {%- else -%}
    {%- liquid
      assign not_found_title = 'modules/blog/blog.post_not_found' | t
      render 'modules/blog/blog/hero', title: not_found_title, subtitle: null, img_path: null, meta_html: null
    -%}
  {%- endif -%}
{%- else -%}
  {%- liquid
    assign not_enabled_title = 'modules/blog/blog.not_enabled' | t
    render 'modules/blog/blog/hero', title: not_enabled_title, subtitle: null, img_path: null, meta_html: null
  -%}
{%- endif -%}

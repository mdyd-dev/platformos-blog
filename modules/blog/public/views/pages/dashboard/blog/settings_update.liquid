---
slug: 'dashboard/blog/settings'
method: put
format: html
layout: 'modules/dashboard/dashboard'
authorization_policies:
  - 'modules/blog/instance_blog_edition'
  - 'modules/dashboard/dashboard_access'
---
{% include 'modules/blog/blog/admin/form_assets' %}
{% liquid
  function blog = 'modules/blog/queries/blog_instances/find', scope: 'blog', slug: null, enabled: null
  assign settings_params = context.params.blog_instance | hash_add_key: 'id', blog.id
  function object = 'modules/blog/commands/blog_instances/update', object: settings_params
  if object.valid
    # platformos-check-disable DeprecatedTag
    include 'modules/core/helpers/redirect_to', url: '/dashboard/blog/settings', notice: 'Settings saved', default: null, error: null, format: null, info: null, object: null
    # platformos-check-enable DeprecatedTag
  else
    render 'modules/blog/blog/admin/settings_form_screen', object: object, errors: object.errors
  endif
%}

---
slug: 'dashboard/posts'
method: post
format: html
layout_name: 'modules/dashboard/dashboard'
authorization_policies:
  - 'modules/blog/instance_blog_edition'
  - 'modules/dashboard/dashboard_access'
---
{% include 'modules/blog/blog/admin/form_assets' %}
{% liquid
  function object = 'modules/blog/commands/blog_posts/create', object: context.params.blog_post
  if object.valid
    # platformos-check-disable DeprecatedTag
    include 'modules/core/helpers/redirect_to', url: '/dashboard/blog', notice: 'Post has been successfully created', default: null, error: null, format: null, info: null, object: null
    # platformos-check-enable DeprecatedTag
  else
    render 'modules/blog/blog/admin/post_form_screen', object: object, errors: object.errors, action: '/dashboard/posts', http_method: 'post', submit_label: 'Create Post'
  endif
%}

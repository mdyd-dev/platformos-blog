---
slug: 'dashboard/posts/:id'
method: put
format: html
layout: 'modules/blog/admin'
---
{% liquid
  function current_profile = 'modules/user/helpers/current_profile'
  # platformos-check-disable DeprecatedTag
  include 'modules/user/helpers/can_do_or_unauthorized', requester: current_profile, do: 'blog.manage', entity: null, access_callback: null, forbidden_partial: 'modules/user/components/pages/403', redirect_anonymous_to_login: true, anonymous_return_to: null
  # platformos-check-enable DeprecatedTag

  assign post_params = context.params.blog_post | hash_add_key: 'id', context.params.id
  function object = 'modules/blog/commands/blog_posts/update', object: post_params
  if object.valid
    # platformos-check-disable DeprecatedTag
    include 'modules/core/helpers/redirect_to', url: '/dashboard/blog', notice: 'Post has been successfully updated', default: null, error: null, format: null, info: null, object: null
    # platformos-check-enable DeprecatedTag
  else
    assign action = '/dashboard/posts/' | append: context.params.id
    assign submit_label = 'modules/blog/admin.update_post' | t
    render 'modules/blog/blog/admin/post_form_screen', object: object, errors: object.errors, action: action, http_method: 'put', submit_label: submit_label
  endif
%}

{% doc %}
  @param {object} context - The request context (CSRF token)
  @param {object} values - The form values object (first_name, last_name, email)
  @param {object} errors - The validation errors object
{% enddoc %}
<section class="pos-user-content blog-auth">

  <h1 class="pos-heading-2">{{ 'modules/blog/auth.edit_profile' | t }}</h1>

  <form action="/edit-profile" method="post" class="pos-form pos-form-simple" data-tc="profile-form">

    <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">

    {% render 'modules/common-styling/forms/error_list', name: 'base', errors: errors['base'] %}

    <fieldset>
      <label for="blog-auth-first-name">{{ 'modules/blog/auth.first_name' | t }}</label>
      <input type="text" name="first_name" id="blog-auth-first-name" value="{{ values.first_name }}" required {% render 'modules/common-styling/forms/error_input_handler', name: 'first_name', errors: errors['first_name'] %}>
      {% render 'modules/common-styling/forms/error_list', name: 'first_name', errors: errors['first_name'] %}
    </fieldset>

    <fieldset>
      <label for="blog-auth-last-name">{{ 'modules/blog/auth.last_name' | t }}</label>
      <input type="text" name="last_name" id="blog-auth-last-name" value="{{ values.last_name }}" required {% render 'modules/common-styling/forms/error_input_handler', name: 'last_name', errors: errors['last_name'] %}>
      {% render 'modules/common-styling/forms/error_list', name: 'last_name', errors: errors['last_name'] %}
    </fieldset>

    <fieldset>
      <label for="blog-auth-email">{{ 'modules/blog/auth.email' | t }}</label>
      <input type="email" id="blog-auth-email" value="{{ values.email }}" disabled title="{{ 'modules/blog/auth.email_locked' | t }}">
    </fieldset>

    <fieldset>
      <button type="submit" class="pos-button pos-button-primary">{{ 'modules/blog/auth.save_profile' | t }}</button>
    </fieldset>

  </form>

</section>

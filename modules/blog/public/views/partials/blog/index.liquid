{% comment %}
  Presentation partial for the blog index / category listing.

  Data is fetched by the owning page (pages/blog/index.liquid,
  pages/blog/category.liquid) and passed in as locals:
    blog_instance       - the blog_instance record (or nil)
    blog_posts          - the posts records collection (results, pagination)
    slug                - blog slug (for the meta title)
    tags                - active category tags (string), or nil
    feature_post_first  - whether to feature the first post
{% endcomment %}
{% assign grid_view_cols_nr = 2 %}

{% if slug != blank and blog_instance %}
  {%- content_for 'meta_title' -%}
    {{ slug | capitalize }}
  {%- endcontent_for -%}

  {% assign header_image_path = blog_instance.header_image.versions.normal | default: blog_instance.header_image.url %}
  {%- include 'modules/blog/blog/hero',
    title: blog_instance.title,
    subtitle: blog_instance.subtitle,
    img_path: header_image_path
  -%}

  <div class="o-section">

    <div class="o-container">

      <div class="c-layout">

        <section class="c-layout__main">

          {% if tags %}
            <div class="o-section__title">Category: <b>{{ tags | join: ',' }}</b></div>
          {% endif %}

          {% if blog_posts.results.size == 0 %}
            <div class="o-section__title">
              Sorry, no content matched your criteria.<br>
              <a href="{{ context.location.href }}">Please go back to main blog page</a>
            </div>
          {% endif %}

          {%- include 'modules/blog/blog/posts-list',
            is_grid_view: blog_instance.grid_view_enabled,
            grid_view_cols: grid_view_cols_nr,
            feature_first: feature_post_first,
            posts: blog_posts.results,
            instance_slug: blog_instance.slug
          -%}

          {%- include 'modules/blog/blog/pagination',
            max_full_pagination: 6,
            max_side_pagination: 2,
            posts: blog_posts
          -%}

        </section>

        {%- if blog_instance.sidebar_enabled -%}
          <aside class="c-layout__sidebar">

            {% assign rss_link = '/blog/rss.rss' %}
            {% include 'modules/blog/blog/social-list',
              widget_title: 'Be in touch',
              facebook_link: blog_instance.facebook_link,
              twitter_link: blog_instance.twitter_link,
              instagram_link: blog_instance.instagram_link,
              linkedin_link: blog_instance.linkedin_link,
              rss_link: rss_link
            %}

            {%- include 'modules/blog/blog/tags-widget',
              widget_title: 'Categories',
              tags: blog_instance.tags_filter
            -%}

            {%-
              include 'modules/blog/blog/facebook-widget',
              facebook_link: blog_instance.facebook_link,
              widget_title: null,
              facebook_link_name: null
            %}

          </aside>
        {%- endif -%}

      </div>

    </div>

  </div>

  {% assign user_id = blog_instance.user.id | plus: 0 %}
  {%- if context.current_user.id == user_id -%}
    {%- include 'modules/blog/blog/flying-button',
      btn_text: 'Setting',
      btn_href: '/dashboard/blog/settings',
      btn_icon: 'equalizer2'
    -%}
  {%- endif -%}
{% else %}
  {%- include 'modules/blog/blog/hero', title: 'Blog is not enabled', subtitle: null, img_path: null -%}
{% endif %}

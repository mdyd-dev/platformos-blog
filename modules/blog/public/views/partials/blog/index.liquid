{% comment %}
  Presentation partial for the blog index / category listing.

  Data is fetched by the owning page (pages/blog/index.liquid,
  pages/blog/category.liquid) and passed in as locals:
    blog_instance       - the blog_instance record (or nil)
    blog_posts          - the posts records collection (results, pagination)
    slug                - blog slug (for the meta title)
    tags                - active category tags (string), or nil
    feature_post_first  - whether to feature the first post
{% endcomment %}
{% if slug != blank and blog_instance %}
  {%- content_for 'meta_title' -%}
    {% if tags %}{{ tags | capitalize }} — {% endif %}{{ blog_instance.title | default: slug | capitalize }}
  {%- endcontent_for -%}

  {% liquid
    assign header_image_path = blog_instance.header_image.versions.hero | default: blog_instance.header_image.versions.normal | default: blog_instance.header_image.url
  %}
  {%- include 'modules/blog/blog/hero',
    title: blog_instance.title,
    subtitle: blog_instance.subtitle,
    img_path: header_image_path,
    meta_html: null
  -%}

  <div class="blog-container blog-section">

    <header class="blog-section-header">
      <h2 class="pos-heading-3 blog-section-title">
        {%- if tags -%}
          Posts tagged &ldquo;{{ tags }}&rdquo;
        {%- else -%}
          Latest articles
        {%- endif -%}
      </h2>

      {%- if blog_instance.tags_filter.size > 0 -%}
        <nav aria-label="Categories">
          <ul class="pos-tags-list blog-tag-filter">
            <li><a class="pos-tag pos-tag-interactive" href="/" {% unless tags %}aria-current="true"{% endunless %}>All</a></li>
            {%- for tag in blog_instance.tags_filter -%}
              <li>
                <a class="pos-tag pos-tag-interactive" href="/blog/category/{{ tag | replace: ' ', '-' }}" {% if tags == tag %}aria-current="true"{% endif %}>
                  {{ tag }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </header>

    {% if blog_posts.results.size == 0 %}
      <div class="pos-card pos-text-center">
        <h3 class="pos-heading-4">Nothing here yet</h3>
        <p class="pos-supplementary">
          No posts matched your criteria.
          <a href="/">Go back to the blog home page</a>
        </p>
      </div>
    {% else %}
      {%- include 'modules/blog/blog/posts-list',
        feature_first: feature_post_first,
        posts: blog_posts.results,
        instance_slug: blog_instance.slug
      -%}

      <div class="pos-mt-section-section">
        {% render 'modules/common-styling/pagination', total_pages: blog_posts.total_pages %}
      </div>
    {% endif %}

  </div>

  {% assign user_id = blog_instance.user.id | plus: 0 %}
  {%- if context.current_user.id == user_id -%}
    {%- include 'modules/blog/blog/flying-button',
      btn_text: 'Blog settings',
      btn_href: '/dashboard/blog/settings',
      btn_icon: 'cog'
    -%}
  {%- endif -%}
{% else %}
  {%- include 'modules/blog/blog/hero', title: 'Blog is not enabled', subtitle: null, img_path: null, meta_html: null -%}
{% endif %}

{% comment %}
  Presentation partial: a single post card (common-styling content card).

  Locals:
    post_item - the blog_post record
    slug      - blog instance slug (for the post URL)
    featured  - boolean; featured cards span the grid with a large layout
{% endcomment %}
{%- liquid
  assign post_href = '/blog/post/' | append: slug | append: '/' | append: post_item.slug
  if featured
    assign image_src = post_item.hero_image.versions.lg | default: post_item.hero_image.url
  else
    assign image_src = post_item.hero_image.versions.m | default: post_item.hero_image.url
  endif
  assign word_count = post_item.content | strip_html | split: ' ' | size
  assign read_minutes = word_count | divided_by: 180 | plus: 1
-%}
<article class="pos-card pos-card-content blog-post-card{% if featured %} blog-post-card-featured{% endif %}">

  {%- if image_src != blank -%}
    <a class="pos-card-content-permalink" href="{{ post_href }}" tabindex="-1" aria-hidden="true">
      <picture class="pos-card-content-image-container">
        <img class="pos-card-content-image" src="{{ image_src }}" alt="" width="736" height="384" loading="lazy">
      </picture>
    </a>
  {%- endif -%}

  <div class="blog-post-card-body">
    {%- if post_item.tags.size > 0 -%}
      {%- assign visible_tags = post_item.tags | slice: 0, 3 -%}
      <ul class="pos-tags-list">
        {%- for post_tag in visible_tags -%}
          <li><a class="pos-tag pos-tag-interactive" href="/blog/category/{{ post_tag | replace: ' ', '-' }}">{{ post_tag }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <h2 class="pos-heading-4 pos-card-content-title">
      <a class="pos-card-content-permalink" href="{{ post_href }}">{{ post_item.title }}</a>
    </h2>

    <p class="blog-post-card-excerpt">
      {%- if post_item.excerpt != blank -%}
        {{ post_item.excerpt }}
      {%- else -%}
        {{ post_item.content | markdown | html_to_text | truncate: 220, '...' }}
      {%- endif -%}
    </p>

    <footer class="pos-card-content-footer">
      <ul>
        <li>
          {% render 'modules/common-styling/icon', icon: 'calendar', class: null %}
          <time datetime="{{ post_item.published_at | date: '%F' }}">{{ post_item.published_at | date: '%b %-d, %Y' }}</time>
        </li>
        <li>
          {% render 'modules/common-styling/icon', icon: 'clock', class: null %}
          {{ 'modules/blog/blog.min_read' | t: minutes: read_minutes }}
        </li>
      </ul>
      {{ post_item.author_name }}
    </footer>
  </div>

</article>

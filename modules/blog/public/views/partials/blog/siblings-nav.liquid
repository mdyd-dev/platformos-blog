{% comment %}
  Presentation partial: previous/next post navigation.

  Data is fetched by the owning page (pages/blog/show.liquid) and passed in:
    previous_post  - the previous blog_post record (or nil)
    next_post      - the next blog_post record (or nil)
    blog_instance  - the blog_instance record (for building post URLs)
{% endcomment %}
{% if previous_post or next_post %}
  <nav class="blog-siblings" aria-label="More posts">

    {% if previous_post %}
      <a class="pos-card" href="/blog/post/{{ blog_instance.slug }}/{{ previous_post.slug }}">
        <span class="blog-siblings-label">
          {% render 'modules/common-styling/icon', icon: 'dashLeft', class: null %}
          Previous post
        </span>
        <span class="pos-card-content-title">{{ previous_post.title }}</span>
      </a>
    {% endif %}

    {%- if next_post -%}
      <a class="pos-card blog-siblings-next" href="/blog/post/{{ blog_instance.slug }}/{{ next_post.slug }}">
        <span class="blog-siblings-label">
          Next post
          {% render 'modules/common-styling/icon', icon: 'dashRight', class: null %}
        </span>
        <span class="pos-card-content-title">{{ next_post.title }}</span>
      </a>
    {% endif %}

  </nav>
{% endif %}

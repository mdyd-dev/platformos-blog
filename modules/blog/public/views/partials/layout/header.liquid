{% comment %}
  Presentation partial: sticky site header. The `dashboard_current_user`
  local is fetched by the layout (layouts/blog.liquid) and passed in.
{% endcomment %}
{% liquid
  function blog_instance = 'modules/blog/queries/blog_instances/find', scope: 'blog', slug: null, enabled: true
  assign brand_title = blog_instance.title | default: 'Blog'
%}
<header class="blog-header">
  <div class="blog-container blog-header-inner">
    <a class="blog-brand" href="/">
      <img class="blog-brand-mark" src="{{ 'modules/blog/images/logo-mark.svg' | asset_url }}" alt="" width="29" height="24">
      {{ brand_title }}
    </a>

    <nav class="blog-header-nav" aria-label="Site navigation">
      <a class="pos-button pos-button-small" href="/blog/rss.rss" title="RSS feed">
        <svg class="pos-icon" aria-hidden="true"><use xlink:href="#blog-icon-feed"></use></svg>
        <span class="pos-label">RSS feed</span>
      </a>

      {% if dashboard_current_user.current_user %}
        <span class="blog-header-user">{{ dashboard_current_user.current_user.first_name }}</span>
        {% if dashboard_current_user.current_user.dashboard.admin == "true" %}
          <a class="pos-button pos-button-small pos-button-primary" href="/dashboard">Dashboard</a>
        {% endif %}
        {% include_form "modules/signup/log_out" %}
      {% else %}
        <a class="pos-button pos-button-small pos-button-primary" href="/log-in">Log in</a>
      {% endif %}
    </nav>
  </div>
</header>

{% comment %}
  Query object: find a single blog_instance record via the records API.

  Wraps graphql/blog_instances/find.graphql so pages fetch the instance with
  {% function ... = 'modules/blog/lib/queries/blog_instances/find' %} and never
  call {% graphql %} from a presentation partial.

  Arguments (all optional):
    scope            - instance scope (e.g. 'blog')
    slug             - instance slug
    enabled          - Boolean; filter on the enabled flag
    current_user_id  - filter to the instance owned by a user

  Returns: the first matching blog_instance record, or nil.
{% endcomment %}
{% liquid
  graphql res = 'modules/blog/blog_instances/find', scope: scope, slug: slug, enabled: enabled, current_user_id: current_user_id
  assign instance = res.customizations.results.first
%}
{% return instance %}

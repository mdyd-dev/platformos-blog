{% doc %}
  @param {string} id - Existing google_analytics record id (blank creates a new record)
  @param {string} tracking_id - The GA tracking id (may be blank to clear tracking)
{% enddoc %}
{% liquid
  assign object = '{}' | parse_json
  assign object = object | hash_add_key: 'id', id
  assign object = object | hash_add_key: 'tracking_id', tracking_id
  assign object = object | hash_add_key: 'valid', true

  if id != blank
    graphql result = 'modules/dashboard/google_analytics/update', id: id, tracking_id: tracking_id
  else
    graphql result = 'modules/dashboard/google_analytics/create', tracking_id: tracking_id
  endif

  if result.errors
    assign object.valid = false
    assign object.errors = result.errors
  else
    assign object.id = result.record.id
  endif

  return object
%}

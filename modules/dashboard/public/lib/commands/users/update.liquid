{% doc %}
  @param {string} id - The user ID
  @param {string} first_name - The first name
  @param {string} last_name - The last name
  @param {string} email - The email address
  @param {string} admin - '1'/'true' grants the dashboard admin flag
{% enddoc %}
{% liquid
  if admin == '1' or admin == 'true' or admin == true
    assign admin_value = 'true'
  else
    assign admin_value = 'false'
  endif

  assign object = '{}' | parse_json
  assign object = object | hash_add_key: 'id', id
  assign object = object | hash_add_key: 'first_name', first_name
  assign object = object | hash_add_key: 'last_name', last_name
  assign object = object | hash_add_key: 'email', email
  assign object = object | hash_add_key: 'admin', admin_value

  assign c = '{"errors": {}, "valid": true}' | parse_json
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'id'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'first_name'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'last_name'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'email'
  function c = 'modules/core/validations/email', c: c, object: object, field_name: 'email'
  assign object.valid = c.valid
  assign object.errors = c.errors

  unless object.valid
    return object
  endunless

  graphql result = 'modules/dashboard/users/update', id: object.id, first_name: object.first_name, last_name: object.last_name, email: object.email, admin: object.admin
  if result.errors
    assign object.valid = false
    assign object.errors = result.errors
  endif

  return object
%}

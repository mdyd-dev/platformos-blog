<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    {%- include 'modules/dashboard/layouts/dashboard/meta-title' -%}

    <!-- Bootstrap core CSS -->
    <link href="{{ 'modules/dashboard/stylesheets/bootstrap.min.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'modules/dashboard/stylesheets/bootstrap-select.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'modules/dashboard/stylesheets/dashboard.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'modules/dashboard/stylesheets/vendor.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'modules/dashboard/stylesheets/admin.css' | asset_url }}" rel="stylesheet">

    <link rel="stylesheet" media="screen" href="https://fonts.googleapis.com/css?family=Open+Sans:400,600,700">

    {% yield 'head_content' %}
  </head>

  <body>
    {%- graphql dashboard_current_user = 'modules/dashboard/dashboard_current_user' %}
    <nav class="navbar navbar-dark fixed-top bg-dark flex-md-nowrap p-0 shadow">
      <a class="navbar-brand col-sm-3 col-md-2 mr-0" href="/">Home</a>
      <ul class="nav navbar-nav flex-row float-right">
        <li class="nav-item p-2 text-light">
          {{ dashboard_current_user.current_user.first_name }}
        </li>
        <li class="nav-item text-nowrap text-light">
          <form action="/log-out" method="post">
            <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
            <button type="submit" class="btn btn-info ml-auto mr-5">Log Out</button>
          </form>
        </li>
      </ul>
    </nav>

    <div class="container-fluid">
      <div class="row">
        {% include 'modules/dashboard/layout/sidebar' %}

        <main role="main" class="col-md-9 ml-sm-auto col-lg-10 px-4">
          {{ content_for_layout }}
        </main>
      </div>
    </div>

    {% liquid
      function sflash = 'modules/core/commands/session/get', key: 'sflash', clear: false
      if context.location.pathname != sflash.from or sflash.force_clear or sflash.now
        function _ = 'modules/core/commands/session/clear', key: 'sflash'
      endif
      assign toast_message = sflash.message
      assign toast_severity = sflash.severity
      if toast_message == blank
        if sflash.error != blank
          assign toast_message = sflash.error
          assign toast_severity = 'error'
        elsif sflash.notice != blank
          assign toast_message = sflash.notice
          assign toast_severity = 'success'
        elsif sflash.info != blank
          assign toast_message = sflash.info
          assign toast_severity = 'info'
        endif
      endif
    %}
    {% render 'modules/common-styling/toasts', message: toast_message, severity: toast_severity, autohide: null, delay: null %}

    {% include 'modules/dashboard/layouts/dashboard/javascripts' %}
  </body>
</html>

  else
    # platformos-check-disable DeprecatedTag
    include 'modules/core/helpers/redirect_to', url: '/dashboard/google_analytics', error: "Google Analytics settings could not be saved", default: null, notice: null, format: null, info: null, object: null
    # platformos-check-enable DeprecatedTag
  endif
%}

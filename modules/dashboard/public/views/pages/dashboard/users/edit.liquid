---
slug: 'dashboard/users/edit/:id'
layout: modules/dashboard/dashboard
authorization_policies:
- "modules/dashboard/dashboard_access"
---
{% liquid
  graphql users = 'modules/dashboard/get_users', id: context.params.id
  assign user = users.users.results.first

  assign values = '{}' | parse_json
  assign values = values | hash_add_key: 'first_name', user.first_name
  assign values = values | hash_add_key: 'last_name', user.last_name
  assign values = values | hash_add_key: 'email', user.email
  assign values = values | hash_add_key: 'admin', user.dashboard.admin
%}
<div class="container pt-4">
  <div class="col-lg-6 col-md-8 col-sm-12 col-12">
    {% render 'modules/dashboard/users/form', context: context, user_id: user.id, values: values, errors: null %}
  </div>
</div>

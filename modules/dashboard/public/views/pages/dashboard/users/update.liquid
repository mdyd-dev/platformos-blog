---
slug: dashboard/users/update
method: post
layout: modules/dashboard/dashboard
authorization_policies:
- "modules/dashboard/dashboard_access"
---
{% liquid
  function object = 'modules/dashboard/commands/users/update', id: context.params.id, first_name: context.params.first_name, last_name: context.params.last_name, email: context.params.email, admin: context.params.admin

  if object.valid
    # platformos-check-disable DeprecatedTag
    include 'modules/core/helpers/redirect_to', url: '/dashboard/users', notice: "You've successfully edited user", default: null, error: null, format: null, info: null, object: null
    # platformos-check-enable DeprecatedTag
  endif
%}
{% unless object.valid %}
  <div class="container pt-4">
    <div class="col-lg-6 col-md-8 col-sm-12 col-12">
      {% render 'modules/dashboard/users/form', context: context, user_id: context.params.id, values: context.params, errors: object.errors %}
    </div>
  </div>
{% endunless %}

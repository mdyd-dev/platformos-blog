{% doc %}
  @param {object} context - The request context (CSRF token)
  @param {string} user_id - The edited user's id
  @param {object} values - first_name, last_name, email, admin ('true' when the flag is set)
  @param {object} errors - The validation errors object
{% enddoc %}
<form action="/dashboard/users/update" method="post">
  <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
  <input type="hidden" name="id" value="{{ user_id }}">

  <div class="form-group">
    <label for="form-first-name">First name</label>
    <input type="text" class="form-control" name="first_name" id="form-first-name" value="{{ values.first_name }}" required>
    {% render 'modules/common-styling/forms/error_list', name: 'first_name', errors: errors['first_name'] %}
  </div>

  <div class="form-group">
    <label for="form-last-name">Last name</label>
    <input type="text" class="form-control" name="last_name" id="form-last-name" value="{{ values.last_name }}" required>
    {% render 'modules/common-styling/forms/error_list', name: 'last_name', errors: errors['last_name'] %}
  </div>

  <div class="form-group">
    <label for="form-email">Email</label>
    <input type="email" class="form-control" name="email" id="form-email" value="{{ values.email }}" required>
    {% render 'modules/common-styling/forms/error_list', name: 'email', errors: errors['email'] %}
  </div>

  <div class="form-group form-check">
    <input type="hidden" name="admin" value="0">
    <input type="checkbox" class="form-check-input" name="admin" id="form-admin" value="1" {% if values.admin == 'true' or values.admin == '1' %}checked{% endif %}>
    <label class="form-check-label" for="form-admin">Admin</label>
  </div>

  <button type="submit" class="btn btn-primary btn-lg">Save</button>
</form>
